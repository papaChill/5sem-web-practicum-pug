back(size)
    background-color #f1f1f1
    box-shadow 4px 5px 10px rgba(0, 0, 0, 0.4)
    padding: size + "%"
    margin 0 0 1% 0

section-style(number)
    display grid
    grid-template-columns 1fr 2fr
    grid-gap 2%
    align-items center
    back(number)
    
    & h3
        grid-column 1/3
        margin 0
        text-align center

    & img
        width: 100%

colorText = #6f6d6d

html
  color colorText

nav
    back(0)
    text-align right

    & a
        display inline-block
        padding 1%
        color colorText
        text-decoration: none
        
        &:hover
        &.active
            background-color #f87777
            color #f8f8f8   

div.images
    display grid
    grid-template-columns repeat(5, 1fr)
    grid-gap 0.5%
    back(1)
    
    & img
        width: 100%   

article
    width 80%
    margin auto
    display grid
    grid-template-columns repeat(3, 1fr)
    grid-gap 4%
    
    & section
        section-style(2)
 
footer
    background-color colorText

    & h4
        padding 5px
        color #f8f8f8

img.big
    display block
    margin: 0 auto

section
    display grid
    grid-template-columns repeat(2, 1fr)


@media (max-width: 700px)

    div.images    
        grid-template-columns 1fr
        overflow hidden
        
        & img
            width 85%
            margin 0 auto           
  
    article
        width 98%
        grid-template-columns 1fr
        grid-gap  1%

    section
        grid-template-columns 1fr

